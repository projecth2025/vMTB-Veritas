# transcript-worker configuration
# Copy to .env and fill in values. Never commit real secrets.

# --- Server ---
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

# --- Supabase (status transitions + segment reads) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# --- GCS artifacts ---
GCS_BUCKET=YOUR-TRANSCRIPT-BUCKET
GCP_PROJECT_ID=YOUR-GCP-PROJECT-ID

# --- Pub/Sub push auth ---
# Must match the token configured on the push subscription. Empty = disabled (dev only).
PUBSUB_PUSH_TOKEN=

# --- LLM minutes-of-meeting (optional; no-op when unset) ---
# provider: "none" (skip MoM) or anything else to enable (e.g. "mistral").
# Any OpenAI-compatible /chat/completions endpoint works.
# Mistral: LLM_BASE_URL=https://api.mistral.ai/v1  LLM_MODEL=mistral-small-latest
LLM_PROVIDER=none
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_API_KEY=
LLM_MODEL=mistral-small-latest
# --- Automatic VM teardown (optional) ---
# After processing a completed meeting the worker POSTs {url}/stop-jitsi so an
# idle Jitsi VM never bills overnight (guarded by live-session heartbeats).
JITSI_ACTIVATOR_URL=
